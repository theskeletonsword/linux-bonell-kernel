# SPDX-License-Identifier: GPL-2.0
#
# Bonnell / perex configuration fragment, applied on top of
#   perex-alpine-stock.config -> olddefconfig -> localmodconfig(perex.lsmod)
# by bonnell/scripts/mkconfig.sh. verify-config.sh fails the build if Kconfig
# drops any value requested here.

## ---------------------------------------------------------------- identity
CONFIG_LOCALVERSION="-bonnell"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y

## ------------------------------------------------- warnings are errors (-Werror)
# -Werror for C, objtool and the linker; W=1 (kbuild's -Wextra set) is passed
# on the make command line by kmake.sh. Section mismatches are errors too.
CONFIG_WERROR=y
# CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
# Compile-test every exported UAPI header against the host libc (musl in
# the build container) as part of the build.
CONFIG_HEADERS_INSTALL=y
CONFIG_UAPI_HEADER_TEST=y

## ------------------------------------------------------------ CPU: Bonnell
CONFIG_X86_MARCH_BONNELL=y
CONFIG_X86_BONNELL_HOT_O3=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# N450 = 1 core / 2 threads; 4 leaves room for a D5xx (2C/4T).
CONFIG_NR_CPUS=4
# CONFIG_NUMA is not set
# CONFIG_X86_X2APIC is not set
# CONFIG_X86_CPU_RESCTRL is not set
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_X86_EXTENDED_PLATFORM is not set
# CONFIG_X86_INTEL_LPSS is not set
# CONFIG_X86_AMD_PLATFORM_DEVICE is not set
# CONFIG_GART_IOMMU is not set
# CONFIG_PERF_EVENTS_INTEL_UNCORE is not set
# ITMT/Turbo Boost Max 3.0 core priorities do not exist on Atom; it would
# also force-select intel_pstate, which does not support Bonnell
# (acpi-cpufreq drives perex's EIST).
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_X86_INTEL_PSTATE is not set
# CONFIG_HALTPOLL_CPUIDLE is not set
CONFIG_INTEL_IDLE=y

# Features Bonnell does not have: dead code and extra entry-path work.
# FRED: not on Bonnell. IBT: no CET; ENDBR64 in every function and 16-byte
# instead of 8-byte IRQ stubs (IDT_ALIGN) for nothing.
# CONFIG_X86_FRED is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_USER_SHADOW_STACK is not set
# CONFIG_X86_SGX is not set

# Bare metal only: no paravirt indirection, no hypervisor guest code.
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_VIRT_DRIVERS is not set

## ------------------------------------------------ attack surface / legacy ABI
# 64-bit only userland (Alpine x86_64, musl): drop the compat syscall ABI
# and its int $0x80 gate, LDT/16-bit segments (removes ESPFIX64 from every
# IRET to user mode), the vsyscall page and ioperm/iopl.
# CONFIG_IA32_EMULATION is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_ACPI_TABLE_UPGRADE is not set
# CONFIG_EFI_CUSTOM_SSDT_OVERLAYS is not set

## ------------------------------------------- speculative execution mitigations
# Bonnell is in-order and listed NO_SPECULATION in cpu_vuln_whitelist: the
# kernel would report "Not affected" for every speculative issue and patch
# the mitigations out at boot anyway. Compiling them out removes KPTI (CR3
# switches on every entry/exit), IBRS/UNRET/IBPB entry code, retpoline and
# return thunks, SLS padding, call-depth tracking and the -fno-jump-tables
# penalty. If this kernel ever boots on a speculative CPU it warns and
# taints (see arch/x86/kernel/cpu/common.c).
# CONFIG_CPU_MITIGATIONS is not set

## --------------------------------------------------------- timer / accounting
# 250 Hz: 4x fewer timer interrupts than the stock 1000 Hz on an in-order
# 1.66 GHz core; tickless idle; no nohz_full context tracking on 2 threads;
# no per-IRQ sched_clock() reads for IRQ time accounting.
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_TICK_CPU_ACCOUNTING=y
# CONFIG_IRQ_TIME_ACCOUNTING is not set

## -------------------------------------------------- memory & usercopy hardening
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_VMAP_STACK=y

## ----------------------------------------------------------- debug overhead
# Full DEBUG_LIST is replaced by LIST_HARDENED; dynamic debug puts a jump
# label in every pr_debug/dev_dbg site (including sky2/ath9k hot paths);
# the function tracer puts a 5-byte NOP at every function entry, which an
# in-order core still has to decode.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_LIST is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_DEBUG_SHIRQ is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_LATENCYTOP is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_MMIOTRACE is not set
# CONFIG_X86_DECODER_SELFTEST is not set
# CONFIG_X86_DEBUG_FPU is not set
# CONFIG_ACPI_EC_DEBUGFS is not set
# CONFIG_BLK_DEBUG_FS is not set

## ------------------------------------------------------------------ modules
CONFIG_MODULES=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# Uncompressed: busybox modprobe in the initramfs loads them directly and the
# cpio is gzip'ed as a whole anyway.
# CONFIG_MODULE_COMPRESS is not set

## ------------------------------------------------------------ boot & storage
CONFIG_KERNEL_ZSTD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_RD_LZ4=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# Root disk path built in (ICH7-M/NM10 AHCI + ext4): boots without initramfs.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_FUSION is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_INTEGRITY is not set
# CONFIG_LDM_PARTITION is not set
# CONFIG_MAC_PARTITION is not set
# CONFIG_ISA_DMA_API is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_LIBNVDIMM is not set
# CONFIG_ANDROID_BINDER_IPC is not set

## -------------------------------------------------------------- filesystems
CONFIG_EXT4_FS=y
# CONFIG_EXT2_FS is not set
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_OVERLAY_FS=m
# FAT only as modules, for USB rescue sticks.
CONFIG_VFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
# CONFIG_FS_DAX is not set
# CONFIG_RESCTRL_FS is not set

## ------------------------------------------------------- console / rescue
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y
# CONFIG_SERIAL_8250_EXAR is not set
# CONFIG_SERIAL_8250_MOXA_PCIE is not set
# CONFIG_SERIAL_8250_DW is not set
# CONFIG_SERIAL_8250_PERICOM is not set
# CONFIG_SERIAL_8250_FINTEK is not set
# CONFIG_SERIAL_8250_EXTENDED is not set
# External USB keyboard/mouse (perex's own keyboard/touchpad are PS/2).
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m

## ------------------------------------------- platform drivers perex lacks
# Bay Trail/Cherry Trail SoC, AMD, server and laptop-vendor pieces that
# stayed built in after localmodconfig.
# CONFIG_INTEL_MEI is not set
# CONFIG_PVPANIC is not set
# CONFIG_PINCTRL_AMD is not set
# CONFIG_PINCTRL_BAYTRAIL is not set
# CONFIG_PINCTRL_CHERRYVIEW is not set
# CONFIG_INTEL_SOC_PMIC is not set
# CONFIG_MFD_INTEL_LPSS_ACPI is not set
# CONFIG_MFD_INTEL_LPSS_PCI is not set
# CONFIG_I2C_DESIGNWARE_CORE is not set
# CONFIG_SPI is not set
# CONFIG_INTEL_ATOMISP is not set
# CONFIG_STAGING is not set
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_MELLANOX_PLATFORM is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_X86_PLATFORM_DRIVERS_DELL is not set
# CONFIG_INTEL_HFI_THERMAL is not set
# CONFIG_POWERCAP is not set
# CONFIG_EDAC is not set
# CONFIG_DMADEVICES is not set
# CONFIG_AUXDISPLAY is not set
# CONFIG_ACCESSIBILITY is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_PCI_IOV is not set
# CONFIG_PCI_P2PDMA is not set
# CONFIG_PCIE_PTM is not set
# CONFIG_ACPI_APEI is not set
# CONFIG_ACPI_EXTLOG is not set
# CONFIG_ACPI_HOTPLUG_MEMORY is not set
# CONFIG_ACPI_PRMT is not set
# CONFIG_APPLE_PROPERTIES is not set
# CONFIG_EFI_COCO_SECRET is not set
# CONFIG_CRYPTO_DEV_CCP is not set
# CONFIG_FDDI is not set
# CONFIG_MOUSE_PS2_VMMOUSE is not set
# CONFIG_XZ_DEC_POWERPC is not set
# CONFIG_XZ_DEC_ARM is not set
# CONFIG_XZ_DEC_ARMTHUMB is not set
# CONFIG_XZ_DEC_ARM64 is not set
# CONFIG_XZ_DEC_SPARC is not set
# CONFIG_XZ_DEC_RISCV is not set
# Webcam (uvcvideo) only: no TV/radio/SDR/platform/test media drivers.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set

## ---------------------------------------------------------------- networking
CONFIG_SKY2=m
# CONFIG_SKY2_DEBUG is not set
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=y
# CONFIG_ATH_DEBUG is not set
# CONFIG_ATH9K_DEBUGFS is not set
# CONFIG_ATH9K_STATION_STATISTICS is not set
# CONFIG_MAC80211_DEBUGFS is not set
# CONFIG_CFG80211_DEBUGFS is not set
# Congestion control / queueing: BBR over FQ (pacing) by default.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
CONFIG_RPS=y
CONFIG_XPS=y
CONFIG_BQL=y
CONFIG_NET_RX_BUSY_POLL=y
# Protocols perex does not use.
# CONFIG_MPTCP is not set
# CONFIG_MPLS is not set
# CONFIG_CAN is not set
# CONFIG_NET_NCSI is not set
# CONFIG_DCB is not set
# CONFIG_NETKIT is not set
# CONFIG_NET_SWITCHDEV is not set
# CONFIG_IPV6_SEG6_LWTUNNEL is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_IPV6_MROUTE is not set
# Netfilter: nftables-only stateful firewall/NAT, as modules. No legacy
# xtables/iptables/ebtables, no netdev ingress/egress hooks; with no ruleset
# loaded the remaining hooks are static keys (zero cost when unused).
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
# CONFIG_NETFILTER_INGRESS is not set
# CONFIG_NETFILTER_EGRESS is not set
# CONFIG_NETFILTER_XTABLES is not set
# CONFIG_IP_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES is not set
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_IP_VS is not set
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
